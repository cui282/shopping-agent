# Live runtime. Configure at least one complete data-provider marketplace channel pair.
APP_ENV=production
AGENT_MODE=auto
SANDBOX_MODE=false
ALLOW_FIXTURE_FALLBACK=false
DEVELOPER_DIAGNOSTIC_MODE=false
ALLOW_RULES_FALLBACK=true

OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
LLM_MAIN=qwen3-30b-a3b-instruct
# Optional lower-cost routes; empty values fall back to LLM_MAIN.
LLM_LITE=
LLM_MINIMAL=
LLM_FALLBACK=
# Optional OpenAI-compatible reasoning control (for example: low, medium, high, max).
LLM_REASONING_EFFORT=
# Use `responses` only when the configured OpenAI-compatible gateway supports it.
LLM_WIRE_API=chat_completions
LLM_RESPONSE_STORAGE=true
PROMPT_VERSION_DIR=./data/prompt_versions
SHOPPING_SKILLS_DIR=./app/skills

# Each endpoint and credential is issued by the licensed data provider for its
# marketplace channel. These are not official marketplace API credentials.
AMAZON_DATA_PROVIDER=
AMAZON_DATA_CHANNEL_ENDPOINT=
AMAZON_DATA_CHANNEL_CREDENTIAL=
SHOPEE_DATA_PROVIDER=
SHOPEE_DATA_CHANNEL_ENDPOINT=
SHOPEE_DATA_CHANNEL_CREDENTIAL=
ALIEXPRESS_DATA_PROVIDER=
ALIEXPRESS_DATA_CHANNEL_ENDPOINT=
ALIEXPRESS_DATA_CHANNEL_CREDENTIAL=
EBAY_DATA_PROVIDER=
EBAY_DATA_CHANNEL_ENDPOINT=
EBAY_DATA_CHANNEL_CREDENTIAL=
# Legacy *_API_ENDPOINT / *_API_KEY aliases remain supported.
TAVILY_API_KEY=

STORE_BACKEND=redis
STORE_REDIS_URL=redis://localhost:6379/2
PREFERENCE_TTL_SECONDS=31536000
# Optional external recall services. Leave blank until each service is reachable.
OPENSEARCH_URL=
OPENSEARCH_CATEGORY_INDEX=shopping_agent_category_kb
OPENSEARCH_SEARCH_PIPELINE=shopping-agent-hybrid-pipeline
ANN_BACKEND=disabled
ANN_INDEX_PATH=./data/item_index.faiss
RECALL_ARCHITECTURE=dual
TOWER_QUERY_ENDPOINT=
TOWER_ITEM_ENDPOINT=
RERANKER_ENDPOINT=

# Every non-CNY live offer must include a time-bound price_conversion quote. Every offer that
# participates in landed-cost ranking must also include a route-specific shipping_quote. These
# values come from the configured data-provider channel; there is no process-wide fallback table.

PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_SECONDS=0.2
PROVIDER_RETRY_BACKOFF_MAX_SECONDS=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_WINDOW_SIZE=20
PROVIDER_CIRCUIT_FAILURE_RATE=0.5
PROVIDER_CIRCUIT_RESET_SECONDS=30
PROVIDER_MAX_CONCURRENCY=4
TASK_TIMEOUT_SECONDS=180
RECALL_TIMEOUT_SECONDS=10
RERANK_TIMEOUT_SECONDS=10
AGENT_MAX_FORK_DEPTH=2
AGENT_MAX_CHILDREN=4
AGENT_MAX_CONCURRENT_CHILDREN=8
AGENT_CHILD_TIMEOUT_SECONDS=90
AGENT_MAX_TOOL_CALLS=24
AGENT_TOOL_RESULT_CHARS=16000
AGENT_LOOP_DETECTION_THRESHOLD=4
LLM_TOKEN_BUDGET=12000
LLM_LITE_TOKEN_THRESHOLD=8000
LLM_MINIMAL_TOKEN_THRESHOLD=4000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_HOST=
MAX_CONCURRENT_TASKS=8
AUTH_ENABLED=true
AUTH_USER_HEADER=X-Auth-User
AUTH_TENANT_HEADER=X-Auth-Tenant
AUTH_SIGNATURE_HEADER=X-Auth-Signature
AUTH_SHARED_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SHUTDOWN_GRACE_SECONDS=15
RELEASE_CHANNEL=stable
RELEASE_ID=live
RELEASE_TRAFFIC_PERCENT=100
RELEASE_ROLLBACK=false
TASK_RETENTION_SECONDS=86400
UPLOAD_MAX_BYTES=8388608
OUTPUT_ROOT=./output
UPLOAD_ROOT=./uploaded
CORS_ORIGINS=https://shopping.example.com
