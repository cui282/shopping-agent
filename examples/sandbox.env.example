# Explicit local sandbox profile. Never use this profile in production.
APP_ENV=development
AGENT_MODE=rules
SANDBOX_MODE=true
ALLOW_FIXTURE_FALLBACK=false
DEVELOPER_DIAGNOSTIC_MODE=false
ALLOW_RULES_FALLBACK=true
STORE_BACKEND=postgres
STORE_POSTGRES_URL=postgresql://shopping_agent:shopping_agent_dev@localhost:5432/shopping_agent
COMPOSE_STORE_POSTGRES_URL=postgresql://shopping_agent:shopping_agent_dev@postgres:5432/shopping_agent
PRODUCT_CATALOG_BACKEND=faiss
PRODUCT_CATALOG_INDEX_DIR=./data/product_index/electronics-hash
# To query the OpenSearch product index instead, set PRODUCT_SEARCH_BACKEND=opensearch,
# start OpenSearch, build product snapshots, and keep the Faiss catalog as a rollback option.
PRODUCT_SEARCH_BACKEND=disabled
PRODUCT_SEARCH_MARKETPLACES=amazon,ebay
PRODUCT_SEARCH_ALLOW_HISTORICAL=true
PRODUCT_SEARCH_EMBEDDING_DIMENSION=384
PRODUCT_SEARCH_EMBEDDING_MODE=sentence-transformer
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EBAY_DESTINATION_COUNTRY=CN
EBAY_DESTINATION_POSTAL_CODE=100000
EBAY_SNAPSHOT_MANIFEST=./data/ebay_snapshots/browse-manifest.json
POSTGRES_DB=shopping_agent
POSTGRES_USER=shopping_agent
POSTGRES_PASSWORD=shopping_agent_dev
RECALL_ARCHITECTURE=dual
RERANKER_ENDPOINT=
COMPOSE_RERANKER_ENDPOINT=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16
AGENT_MAX_FORK_DEPTH=2
AGENT_MAX_CHILDREN=4
AGENT_MAX_CONCURRENT_CHILDREN=8
AGENT_CHILD_TIMEOUT_SECONDS=90
AGENT_MAX_TOOL_CALLS=24
AGENT_TOOL_RESULT_CHARS=16000
AGENT_LOOP_DETECTION_THRESHOLD=4
LLM_TOKEN_BUDGET=12000
LLM_LITE_TOKEN_THRESHOLD=8000
LLM_MINIMAL_TOKEN_THRESHOLD=4000
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=sandbox
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
AUTH_ENABLED=false
RATE_LIMIT_ENABLED=false
SHUTDOWN_GRACE_SECONDS=1
RELEASE_CHANNEL=stable
RELEASE_ID=local-sandbox
RELEASE_TRAFFIC_PERCENT=100
RELEASE_ROLLBACK=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OUTPUT_ROOT=./output
UPLOAD_ROOT=./uploaded
UPLOAD_MAX_BYTES=8388608
